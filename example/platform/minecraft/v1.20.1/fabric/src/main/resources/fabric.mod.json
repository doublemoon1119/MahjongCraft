{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["${author}"],
  "license": "${license}",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.doublemoon1119.mahjongcraft.example.fabric.ExampleMod"],
    "client": ["com.doublemoon1119.mahjongcraft.example.fabric.ExampleModClient"],
    "mahjongcraft:extension": ["com.doublemoon1119.mahjongcraft.example.fabric.ExampleFabricMahjongExtension"]
  },
  "depends": {
    "mahjongcraft": "${version}",
    "fabricloader": "${dependencyRequirements.fabricLoader}",
    "fabric": "${dependencyRequirements.fabricApi}",
    "minecraft": "${dependencyRequirements.minecraft}",
    "fabric-language-kotlin": "${dependencyRequirements.fabricLanguageKotlin}"
  }
}
