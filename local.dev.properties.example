# Development Environment Configuration Example
# ---------------------------------------------
# This file serves as a template. Copy this file and rename it to 'local.dev.properties'
# for your actual configuration. 'local.dev.properties' is ignored by Git to prevent
# local settings from being committed.
# The target Minecraft version folder name (located under /versions/, above the loader level)
# Example: v1.20.1, v1.21.1
targetVersion=v1.20.1

# The target mod loader name (located under the corresponding version folder)
# Example: fabric, neoforge
targetLoader=fabric