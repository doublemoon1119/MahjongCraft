{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.doublemoon1119.mahjongcraft.platform.fabric.MahjongCraftMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.doublemoon1119.mahjongcraft.platform.fabric.MahjongCraftModClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric": "*",
    "minecraft": "1.20.1",
    "fabric-language-kotlin": "*"
  }
}
